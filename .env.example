# Optional for local demo — if unset, the server uses an in-memory store
# (data resets when the process exits). Required for production deploys.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
NODE_ENV=production
PORT=10000
# Canonical public URL (canonical/OG/sitemap). Defaults to sadhana-yoga.onrender.com.
PUBLIC_APP_URL=https://sadhana-yoga.onrender.com
# Set to 1 only on trusted self-hosted demos to return reset tokens in API JSON.
# EXPOSE_RESET_TOKEN=1
