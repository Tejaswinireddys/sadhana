# Optional for local demo — if unset, the server uses an in-memory store
# (data resets when the process exits). Required for production deploys.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
NODE_ENV=production
PORT=10000
# Canonical public URL (canonical/OG/sitemap). Use a real custom domain in production.
PUBLIC_APP_URL=https://sadhana-ou9m.onrender.com
# HMAC secret for signed guest device cookies (falls back to SESSION_SECRET).
# DEVICE_ID_SECRET=
# SESSION_SECRET=
# Emergency only: allow bare X-Device-Id without proof (re-opens UUID replay). Keep off in prod.
# ALLOW_LEGACY_DEVICE_HEADER=0
# Error monitoring (Sentry). Server uses SENTRY_DSN; browser uses VITE_SENTRY_DSN.
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
# VITE_SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project>
# SENTRY_RELEASE=
# VITE_SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# Platform API key for /api/v1 (optional; demo key sadhana-demo-key works when unset).
# SADHANA_API_KEY=
# Set to 1 only on trusted self-hosted demos to return reset/verify tokens in API JSON.
# EXPOSE_RESET_TOKEN=1
# EXPOSE_VERIFY_TOKEN=1

# Transactional email via Resend (optional). Without it, messages are posted to
# EMAIL_WEBHOOK_URL when set, otherwise logged to the server console for local/dev.
# Covers: verify, welcome, password reset/changed, account deleted, subscription
# started, cancel confirm, renewal reminder, payment failed, refund confirm.
# RESEND_API_KEY=
# EMAIL_FROM=Sadhana <hello@yourdomain.com>
# EMAIL_WEBHOOK_URL=
# BILLING_DISPATCH_SECRET=  # optional header x-billing-secret for renewal dispatch

# Transactional email for password reset (optional; without it the reset code is
# only written to the server log). Set ONE provider:
#   Resend HTTP API:
# RESEND_API_KEY=
#   or a generic relay/SMTP bridge that accepts {to,from,subject,text,html} JSON:
# EMAIL_WEBHOOK_URL=
# EMAIL_FROM=Sadhana <no-reply@yourdomain.com>

# Web Push (VAPID) — optional; ephemeral keys are generated when unset.
# Set stable keys in production so browser subscriptions survive restarts.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@yourdomain.com
# PUSH_DISPATCH_SECRET=  # optional header x-push-secret for /api/push/dispatch-reminders
# (An in-process scheduler also dispatches due reminders every 10 minutes.)

# Stripe Checkout for Plus/Coach (optional — billing stays off until set).
# Cancel is in-app (two taps from Home); portal is for payment-method updates only.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PLUS_MONTHLY=
# STRIPE_PRICE_PLUS_YEARLY=
# STRIPE_PRICE_COACH_MONTHLY=
# STRIPE_PRICE_COACH_YEARLY=
# BILLING_CANCEL_TOKEN_SECRET=  # HMAC for one-click email cancel links
# BILLING_DISPATCH_SECRET=      # optional guard for reminder dispatch
# BILLING_COMPLIANCE_DEMO=1     # allow POST /api/billing/demo-subscribe in production-like envs

# Transactional email (verify, welcome, cancel, renewal, refund…). Logs when unset.
# RESEND_API_KEY=
# EMAIL_FROM=Sadhana <noreply@yourdomain.com>
# EMAIL_WEBHOOK_URL=            # alternative to Resend: POST JSON {to,subject,html,text,kind}

# PostHog product analytics (optional — local funnel dashboard works without it).
# Use a self-hosted host or the EU cloud (https://eu.i.posthog.com).
# VITE_PUBLIC_POSTHOG_KEY=phc_...
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side purchase/cancel capture (falls back to VITE_PUBLIC_POSTHOG_KEY):
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com
